###############################################################
# Codex muted green skin for Warm Sand Windows Terminal colors
#
# Copy this file to:
#   %APPDATA%\dystroy\broot\config\skins\codex-muted-green.hjson
#
# Then enable it in broot conf.hjson:
#   file: skins/codex-muted-green.hjson
###############################################################

skin: {
    default: rgb(210, 196, 164) None / rgb(180, 166, 140) None
    tree: rgb(118, 150, 140) None / rgb(94, 120, 112) None
    parent: rgb(230, 219, 191) None Bold / rgb(210, 196, 164) None
    file: rgb(210, 196, 164) None / rgb(180, 166, 140) None Italic
    directory: rgb(148, 184, 154) None Bold / rgb(118, 150, 140) None
    exe: rgb(102, 217, 181) None
    link: rgb(210, 145, 170) None
    pruning: rgb(160, 172, 154) None Italic

    perm__: rgb(160, 172, 154) None
    perm_r: rgb(184, 154, 96) None
    perm_w: rgb(196, 126, 126) None
    perm_x: rgb(118, 150, 140) None
    owner: rgb(184, 154, 96) None Bold
    group: rgb(184, 154, 96) None

    count: rgb(20, 170, 132) rgb(35, 35, 35)
    dates: rgb(160, 172, 154) None
    sparse: rgb(235, 220, 180) None

    content_extract: rgb(102, 217, 181) None Italic
    content_match: rgb(210, 145, 170) None Bold

    git_branch: rgb(235, 220, 180) None
    git_insertions: rgb(148, 184, 154) None
    git_deletions: rgb(220, 95, 95) None
    git_status_current: rgb(160, 172, 154) None
    git_status_modified: rgb(235, 220, 180) None
    git_status_new: rgb(102, 217, 181) None Bold
    git_status_ignored: rgb(120, 148, 139) None
    git_status_conflicted: rgb(220, 95, 95) None
    git_status_other: rgb(196, 126, 126) None

    selected_line: None rgb(58, 58, 58) / None rgb(48, 50, 50)
    char_match: rgb(210, 145, 170) None Bold
    file_error: rgb(220, 95, 95) None
    flag_label: rgb(160, 172, 154) None
    flag_value: rgb(235, 220, 180) None Bold
    input: rgb(240, 232, 208) rgb(35, 35, 35) / rgb(210, 196, 164) rgb(35, 35, 35) Italic

    status_error: rgb(240, 232, 208) rgb(196, 126, 126)
    status_job: rgb(35, 35, 35) rgb(184, 154, 96)
    status_normal: rgb(210, 196, 164) rgb(35, 35, 35) / None None
    status_italic: rgb(226, 168, 187) rgb(35, 35, 35) Italic / None None
    status_bold: rgb(235, 220, 180) rgb(35, 35, 35) Bold / None None
    status_code: rgb(240, 232, 208) rgb(35, 35, 35) / None None
    status_ellipsis: rgb(240, 232, 208) rgb(35, 35, 35) Bold / None None

    purpose_normal: None None
    purpose_italic: rgb(118, 150, 140) None Italic
    purpose_bold: rgb(148, 184, 154) None Bold
    purpose_ellipsis: None None

    scrollbar_track: rgb(58, 58, 58) None / rgb(48, 50, 50) None
    scrollbar_thumb: rgb(210, 196, 164) None / rgb(160, 172, 154) None

    help_paragraph: rgb(210, 196, 164) None
    help_bold: rgb(235, 220, 180) None Bold
    help_italic: rgb(226, 168, 187) None Italic
    help_code: rgb(102, 217, 181) rgb(35, 35, 35)
    help_headers: rgb(148, 184, 154) None Bold
    help_table_border: rgb(58, 58, 58) None

    preview_title: rgb(230, 219, 191) rgb(35, 35, 35) / rgb(210, 196, 164) rgb(35, 35, 35)
    preview: rgb(210, 196, 164) None / rgb(210, 196, 164) None
    preview_line_number: rgb(160, 172, 154) rgb(35, 35, 35) / rgb(160, 172, 154) None
    preview_separator: rgb(58, 58, 58) None
    preview_match: None rgb(184, 154, 96) Bold

    hex_null: rgb(160, 172, 154) None
    hex_ascii_graphic: rgb(210, 196, 164) None
    hex_ascii_whitespace: rgb(118, 150, 140) None
    hex_ascii_other: rgb(184, 154, 96) None
    hex_non_ascii: rgb(196, 126, 126) None

    staging_area_title: rgb(230, 219, 191) rgb(35, 35, 35) / rgb(210, 196, 164) rgb(35, 35, 35)
    mode_command_mark: rgb(35, 35, 35) rgb(210, 145, 170) Bold

    good_to_bad_0: rgb(148, 184, 154)
    good_to_bad_1: rgb(148, 184, 154)
    good_to_bad_2: rgb(148, 184, 154)
    good_to_bad_3: rgb(118, 150, 140)
    good_to_bad_4: rgb(184, 154, 96)
    good_to_bad_5: rgb(184, 154, 96)
    good_to_bad_6: rgb(196, 126, 126)
    good_to_bad_7: rgb(196, 126, 126)
    good_to_bad_8: rgb(220, 95, 95)
    good_to_bad_9: rgb(220, 95, 95)
}

syntax_theme: MochaDark
